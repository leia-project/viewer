# URL to the configuration file (JSON). Without trailing slash.
CONFIG_URL=http://localhost:4200/example.config.json
# Base URL for the application. Without trailing slash.
APP_URL=http://localhost:4200
# URL to the config server, only needed if the config_switcher tool is used. Without trailing slash.
CONFIG_SERVER_URL=http://localhost:3000/acc
# Optional comma-separated extra origins that ?config= may load configs from (the viewer's own origin and those of CONFIG_URL/CONFIG_SERVER_URL are always allowed).
CONFIG_ALLOWED_ORIGINS=
